mainmenu "batmon - battery CAN monitor"

menu "batmon"

config BATMON_DEVICE_ID
	string "Device id (MQTT client id, topic element, display)"
	default "batmon"

config BATMON_CAN_BITRATE
	int "CAN bitrate in bit/s"
	default 500000

config BATMON_CAN_LISTEN_ONLY
	bool "Listen-only: never acknowledge or transmit on the bus"
	default y
	help
	  Recommended when batmon is attached to a bus that already carries a
	  battery and an inverter. Disable only on the bench, where batmon is the
	  only counterpart of the battery.

config BATMON_BENCH_HEARTBEAT
	bool "Send the inverter keep-alive 0x305 once per second (bench mode)"
	depends on !BATMON_CAN_LISTEN_ONLY
	default n
	help
	  Many BMS firmwares stop reporting or open the contactor when no inverter
	  heartbeat is seen. With this option batmon plays the inverter role.

config BATMON_RAW_LOG
	bool "Log every received CAN frame"
	default n

config BATMON_MQTT
	bool "Publish telemetry over MQTT"
	default y

if BATMON_MQTT

config BATMON_MQTT_BROKER_HOST
	string "Broker host name or IPv4 address"
	default "192.168.1.10"

config BATMON_MQTT_BROKER_PORT
	int "Broker TCP port"
	default 1883

config BATMON_MQTT_USERNAME
	string "User name (ThingsBoard: device access token)"
	default ""

config BATMON_MQTT_PASSWORD
	string "Password"
	default ""

config BATMON_MQTT_INTERVAL_SEC
	int "Publish interval in seconds"
	default 5
	range 1 3600

choice BATMON_MQTT_MODE
	prompt "Topic and payload scheme"
	default BATMON_MQTT_MODE_GENERIC

config BATMON_MQTT_MODE_GENERIC
	bool "Generic: <prefix>/<id>/state JSON, <prefix>/<id>/status LWT"

config BATMON_MQTT_MODE_THINGSBOARD
	bool "ThingsBoard device API: v1/devices/me/telemetry (flat JSON)"

endchoice

config BATMON_MQTT_TOPIC_PREFIX
	string "Topic prefix (generic mode)"
	default "batmon"
	depends on BATMON_MQTT_MODE_GENERIC

config BATMON_HA_DISCOVERY
	bool "Publish Home Assistant MQTT discovery messages"
	default y
	depends on BATMON_MQTT_MODE_GENERIC

endif # BATMON_MQTT

menuconfig BATMON_RS485
	bool "RS485/UART BMS link (Pylontech/PACE/Seplos ASCII, JK-BMS, Seplos V3 Modbus)"
	default y
	depends on DT_HAS_PROTRONIC_BATMON_RS485_ENABLED
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	select UART_USE_RUNTIME_CONFIGURE
	select RING_BUFFER
	help
	  Poll the BMS over its RS485 port (or listen to an inverter doing so) in
	  addition to the CAN bus. Needs a batmon-rs485 node in the devicetree.

if BATMON_RS485

config BATMON_RS485_LISTEN_ONLY
	bool "Listen only: decode the traffic between inverter and BMS, never transmit"
	default n

config BATMON_RS485_POLL_MS
	int "Poll interval in ms"
	default 2000
	range 200 60000

config BATMON_RS485_BAUD
	int "Fixed baud rate (0 = try 9600, 19200 and 115200)"
	default 0

config BATMON_RS485_ADDR
	int "Fixed pack address (-1 = try the usual ones)"
	default -1
	range -1 15
	help
	  Pylontech packs answer on address 2 (first module), PACE on 1,
	  Seplos on 0.

choice BATMON_RS485_FLAVOR
	prompt "Protocol"
	default BATMON_RS485_FLAVOR_AUTO

config BATMON_RS485_FLAVOR_AUTO
	bool "Auto-detect"

config BATMON_RS485_FLAVOR_PYLON
	bool "Pylontech ASCII (US2000/US3000/US5000, Force L)"

config BATMON_RS485_FLAVOR_PACE
	bool "PACE ASCII (FM-Solar/DelongTop, Gobel, SOK ...)"

config BATMON_RS485_FLAVOR_SEPLOS
	bool "Seplos V2 ASCII"

config BATMON_RS485_FLAVOR_JK
	bool "JK-BMS RS485"

config BATMON_RS485_FLAVOR_SEPLOS_V3
	bool "Seplos V3 Modbus RTU"

endchoice

config BATMON_JK_CURRENT_LEGACY
	bool "JK-BMS: old firmware current encoding (10000 - raw)"
	default n

endif # BATMON_RS485

config BATMON_UI
	bool "Status screen on the board display (LVGL)"
	default y
	depends on LVGL

endmenu

source "Kconfig.zephyr"
