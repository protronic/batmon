/*
 * batmon on the STM32H573I-DK
 *
 * The Discovery kit has no CAN transceiver on board. FDCAN2 is routed to the
 * Arduino header, so a small 3.3 V transceiver breakout (SN65HVD230, TJA1051T/3,
 * MCP2562FD ...) connects directly:
 *
 *   PB5  FDCAN2_RX  -> Arduino D3   (transceiver RXD)
 *   PB6  FDCAN2_TX  -> Arduino D15  (transceiver TXD, the pin labelled SCL)
 *   3V3 / GND       -> transceiver supply (3.3 V logic!)
 *
 * PB5/PB6 are otherwise TIM3_CH2 (D3 PWM) and I2C1_SCL (Arduino I2C), both unused
 * by batmon and therefore disabled here.
 *
 * Alternative: the board devicetree wires FDCAN1 to PA11/PA12, which are shared
 * with the USB-C data lines. To use that instead, drop the fdcan2 block below,
 * set `zephyr,canbus = &fdcan1;`, add bitrate/sample-point to &fdcan1 and
 * disable &usb.
 *
 * RS485 (optional): USART3 on the Arduino header plus a 3.3 V RS485 transceiver
 * (MAX3485, SP3485, TI SN65HVD72 ...):
 *
 *   PB10 USART3_TX  -> Arduino D1  (transceiver DI)
 *   PB11 USART3_RX  -> Arduino D0  (transceiver RO)
 *   PG15 GPIO       -> Arduino D2  (transceiver DE and /RE tied together)
 *
 * Drop the de-gpios line for modules with automatic direction control. PB10/PB11
 * are shared with I2C2, which batmon does not use.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,canbus = &fdcan2;
	};

	batmon_rs485: batmon-rs485 {
		compatible = "protronic,batmon-rs485";
		uart = <&usart3>;
		de-gpios = <&gpiog 15 GPIO_ACTIVE_HIGH>;
	};

	/* touch panel -> LVGL pointer; add swap-xy / invert-x / invert-y here if the
	 * touch position is mirrored against the display */
	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&ft3267>;
	};
};

&usart3 {
	current-speed = <9600>;
};

&i2c2 {
	status = "disabled";
};

&fdcan2 {
	clocks = <&rcc STM32_CLOCK(APB1_2, 9)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb6>;
	pinctrl-names = "default";
	bitrate = <500000>;
	sample-point = <875>;
	status = "okay";
};

&pwm3 {
	status = "disabled";
};

&timers3 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
